# Workspace member build output. The existing `/target` rule is root-anchored.
wasm/target/
ffi/target/
python/target/
# Python build and test leftovers.
__pycache__/
*.egg-info/
.pytest_cache/
python/.venv/
# wasm-pack output (rebuilt by CI and by the web app's build)
wasm/pkg/

# The Pages site.
web/node_modules/
web/dist/
# Generated by `npm run wasm` — build output, not source.
web/src/wasm/

# Scratch output from driving the site in a browser locally.
.playwright-mcp/

# Local Function secrets for `wrangler pages dev` — the Analytics Engine read
# token lives here when developing the stats page. Never committed; in
# production it is set with `wrangler pages secret put`.
.dev.vars
# `wrangler pages dev` keeps its local KV and cache state here.
.wrangler/

